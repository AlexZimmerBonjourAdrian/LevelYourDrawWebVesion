{"roles": [{"id": "protagonista", "es": "Protagonista", "en": "Protagonist", "gloss_es": "Eje de la historia; todo pasa por él.", "gloss_en": "Story's axis; all passes through them.", "guide_es": "Carga el arco y cambia al final. Ej: Don Quijote.", "guide_en": "Carries the arc and changes. E.g.: Don Quixote."}, {"id": "deuteragonista", "es": "Deuteragonista", "en": "Deuteragonist", "gloss_es": "Segundo protagonista de la historia.", "gloss_en": "Second lead of the story.", "guide_es": "Segundo peso; refleja o reta al héroe. Ej: Sancho Panza.", "guide_en": "Second weight; mirrors or challenges the hero. E.g.: Sancho Panza."}, {"id": "tritagonista", "es": "Tritagonista", "en": "Tritagonist", "gloss_es": "Tercer peso narrativo.", "gloss_en": "Third narrative weight.", "guide_es": "El voto que decide.", "guide_en": "The deciding vote."}, {"id": "antagonista", "es": "Antagonista", "en": "Antagonist", "gloss_es": "Fuerza que se opone al héroe.", "gloss_en": "Force opposing the hero.", "guide_es": "Se opone al héroe hasta el clímax. Ej: el tirano.", "guide_en": "Opposes the hero to the climax. E.g.: the tyrant."}, {"id": "mentor", "es": "Mentor", "en": "Mentor", "gloss_es": "Guía que enseña al héroe.", "gloss_en": "Guide who teaches the hero.", "guide_es": "Enseña y suele partir. Ej: el maestro anciano.", "guide_en": "Teaches, often departs. E.g.: the elder master."}, {"id": "aprendiz", "es": "Aprendiz", "en": "Apprentice", "gloss_es": "Aprende de un maestro.", "gloss_en": "Learning from a master.", "guide_es": "Crece hasta superar al maestro.", "guide_en": "Grows to surpass the master."}, {"id": "aliado", "es": "Aliado", "en": "Ally", "gloss_es": "Lucha junto al héroe.", "gloss_en": "Fights beside the hero.", "guide_es": "Sostiene al héroe en su hora baja.", "guide_en": "Holds the hero at low hour."}, {"id": "rival", "es": "Rival", "en": "Rival", "gloss_es": "Compite contra el héroe.", "gloss_en": "Competes against the hero.", "guide_es": "Mide fuerzas sin ser villano.", "guide_en": "Tests strength, no villain."}, {"id": "traidor", "es": "Traidor", "en": "Traitor", "gloss_es": "Finge lealtad y traiciona.", "gloss_en": "Feigns loyalty, then betrays.", "guide_es": "Su giro rompe confianzas. Ej: el amigo que vende.", "guide_en": "Their turn breaks trust. E.g.: the friend who sells out."}, {"id": "heroe", "es": "Héroe", "en": "Hero", "gloss_es": "Encara el mal con valor.", "gloss_en": "Faces evil with courage.", "guide_es": "Actúa por el bien común.", "guide_en": "Acts for the common good."}, {"id": "villano", "es": "Villano", "en": "Villain", "gloss_es": "Causa el conflicto central.", "gloss_en": "Drives the central conflict.", "guide_es": "Quiere lo contrario al héroe.", "guide_en": "Wants the opposite of the hero."}, {"id": "antiheroe", "es": "Antihéroe", "en": "Antihero", "gloss_es": "Héroe sin moral ejemplar.", "gloss_en": "Hero without exemplary morals.", "guide_es": "Hace el bien con malos modos.", "guide_en": "Does good with bad manners."}, {"id": "secuaz", "es": "Secuaz", "en": "Henchman", "gloss_es": "Obedece al villano.", "gloss_en": "Obeys the villain.", "guide_es": "Manos del villano.", "guide_en": "The villain's hands."}, {"id": "lider", "es": "Líder", "en": "Leader", "gloss_es": "Comanda al grupo.", "gloss_en": "Commands the group.", "guide_es": "La culpa final es suya.", "guide_en": "Final blame is theirs."}, {"id": "rebelde", "es": "Rebelde", "en": "Rebel", "gloss_es": "Desafía a la autoridad.", "gloss_en": "Defies authority.", "guide_es": "Rompe la norma reinante.", "guide_en": "Breaks the ruling norm."}, {"id": "marginado", "es": "Marginado", "en": "Outcast", "gloss_es": "Vive al borde del grupo.", "gloss_en": "Lives at the group's edge.", "guide_es": "Cerca, pero nunca dentro.", "guide_en": "Close, never inside."}, {"id": "huerfano", "es": "Huérfano", "en": "Orphan", "gloss_es": "Sin padres que lo amparen.", "gloss_en": "No parents to shelter them.", "guide_es": "Se crió solo.", "guide_en": "Raised themselves."}, {"id": "heredero", "es": "Heredero", "en": "Heir", "gloss_es": "Recibe un legado (o carga).", "gloss_en": "Receives a legacy (or burden).", "guide_es": "Nació con deuda.", "guide_en": "Born into debt."}, {"id": "fugitivo", "es": "Fugitivo", "en": "Fugitive", "gloss_es": "Huye de quien lo persigue.", "gloss_en": "Fleeing pursuers.", "guide_es": "Vive mirando atrás.", "guide_en": "Lives looking back."}, {"id": "guardian", "es": "Guardián", "en": "Guardian", "gloss_es": "Protege algo o a alguien.", "gloss_en": "Protects something or someone.", "guide_es": "Su vida es el precio.", "guide_en": "Their life is the price."}, {"id": "explorador", "es": "Explorador", "en": "Explorer", "gloss_es": "Descubre lo desconocido.", "gloss_en": "Discovers the unknown.", "guide_es": "Pisa donde nadie.", "guide_en": "Steps where no one has."}, {"id": "visionario", "es": "Visionario", "en": "Visionary", "gloss_es": "Ve lo que otros no ven.", "gloss_en": "Sees what others don't.", "guide_es": "Ve el futuro y asusta.", "guide_en": "Sees future, unsettles."}, {"id": "martir", "es": "Mártir", "en": "Martyr", "gloss_es": "Sufre (o muere) por su causa.", "gloss_en": "Suffers (or dies) for the cause.", "guide_es": "Su caída une a otros.", "guide_en": "Their fall unites others."}, {"id": "embustero", "es": "Embustero", "en": "Trickster", "gloss_es": "Engaña con ingenio.", "gloss_en": "Deceives with wit.", "guide_es": "Miente para sobrevivir.", "guide_en": "Lies to survive."}, {"id": "sabio", "es": "Sabio", "en": "Sage", "gloss_es": "Sabe más de lo que dice.", "gloss_en": "Knows more than they say.", "guide_es": "Responde con enigmas.", "guide_en": "Answers in riddles."}, {"id": "maestro", "es": "Maestro", "en": "Master", "gloss_es": "Domina un arte y lo enseña.", "gloss_en": "Masters a craft and teaches it.", "guide_es": "Exige hasta el límite.", "guide_en": "Pushes to the limit."}, {"id": "companero", "es": "Compañero", "en": "Companion", "gloss_es": "Acompaña al héroe.", "gloss_en": "Walks beside the hero.", "guide_es": "Comparte el camino.", "guide_en": "Shares the road."}, {"id": "enemigo", "es": "Enemigo", "en": "Enemy", "gloss_es": "Se opone abiertamente.", "gloss_en": "Openly opposed.", "guide_es": "Choca de frente.", "guide_en": "Clashes head-on."}, {"id": "superviviente", "es": "Superviviente", "en": "Survivor", "gloss_es": "Siguió vivo contra todo.", "gloss_en": "Stayed alive against odds.", "guide_es": "Cicatrices que hablan.", "guide_en": "Scars that speak."}, {"id": "peregrino", "es": "Peregrino", "en": "Pilgrim", "gloss_es": "Viaja por fe o promesa.", "gloss_en": "Travels on faith or vow.", "guide_es": "Cada paso es voto.", "guide_en": "Every step is a vow."}, {"id": "nomada", "es": "Nómada", "en": "Nomad", "gloss_es": "Sin hogar fijo.", "gloss_en": "No fixed home.", "guide_es": "Pertenece al camino.", "guide_en": "Belongs to the road."}, {"id": "ermitano", "es": "Ermitaño", "en": "Hermit", "gloss_es": "Vive aislado del mundo.", "gloss_en": "Lives apart from the world.", "guide_es": "Eligió la soledad.", "guide_en": "Chose solitude."}, {"id": "profeta", "es": "Profeta", "en": "Prophet", "gloss_es": "Anuncia lo por venir.", "gloss_en": "Foretells what comes.", "guide_es": "Su aviso nadie cree.", "guide_en": "No one believes the warning."}, {"id": "oraculo", "es": "Oráculo", "en": "Oracle", "gloss_es": "Revela verdades incómodas.", "gloss_en": "Reveals uncomfortable truths.", "guide_es": "Cobra caro cada verdad.", "guide_en": "Charges dear for each truth."}, {"id": "juez", "es": "Juez", "en": "Judge", "gloss_es": "Decide sobre otros.", "gloss_en": "Passes judgment on others.", "guide_es": "Su vara no tiembla.", "guide_en": "Their rod doesn't shake."}, {"id": "verdugo", "es": "Verdugo", "en": "Executioner", "gloss_es": "Ejecuta el castigo.", "gloss_en": "Carries out punishment.", "guide_es": "Mata por oficio.", "guide_en": "Kills by trade."}, {"id": "prisionero", "es": "Prisionero", "en": "Prisoner", "gloss_es": "Privado de libertad.", "gloss_en": "Deprived of freedom.", "guide_es": "Cuenta rejas y días.", "guide_en": "Counts bars and days."}, {"id": "libertador", "es": "Libertador", "en": "Liberator", "gloss_es": "Libera a los oprimidos.", "gloss_en": "Frees the oppressed.", "guide_es": "Su victoria es ajena.", "guide_en": "Their victory belongs to others."}, {"id": "fundador", "es": "Fundador", "en": "Founder", "gloss_es": "Inicia algo que perdura.", "gloss_en": "Starts what endures.", "guide_es": "Primero en llegar.", "guide_en": "First to arrive."}, {"id": "heraldo", "es": "Heraldo", "en": "Herald", "gloss_es": "Anuncia el cambio que viene.", "gloss_en": "Herald of coming change.", "guide_es": "Llega antes del giro.", "guide_en": "Arrives before the turn."}, {"id": "centinela", "es": "Centinela", "en": "Sentinel", "gloss_es": "Vigila y da la alarma.", "gloss_en": "Keeps watch, raises alarm.", "guide_es": "No duerme en su turno.", "guide_en": "Never sleeps on watch."}, {"id": "testigo", "es": "Testigo", "en": "Witness", "gloss_es": "Vio lo que otros niegan.", "gloss_en": "Saw what others deny.", "guide_es": "Su memoria condena.", "guide_en": "Memory condemns."}, {"id": "complice", "es": "Cómplice", "en": "Accomplice", "gloss_es": "Ayuda en secreto.", "gloss_en": "Helps in secret.", "guide_es": "Cubre al culpable.", "guide_en": "Covers the guilty."}, {"id": "espia", "es": "Espía", "en": "Spy", "gloss_es": "Roba secretos ajenos.", "gloss_en": "Steals others' secrets.", "guide_es": "Vive de secretos.", "guide_en": "Lives off secrets."}, {"id": "infiltrado", "es": "Infiltrado", "en": "Infiltrator", "gloss_es": "Vive entre el enemigo.", "gloss_en": "Lives among the enemy.", "guide_es": "Finge ser de los otros.", "guide_en": "Pretends to be one of them."}, {"id": "desertor", "es": "Desertor", "en": "Deserter", "gloss_es": "Abandonó su bando.", "gloss_en": "Abandoned their side.", "guide_es": "Rompió su juramento.", "guide_en": "Broke their oath."}, {"id": "exiliado", "es": "Exiliado", "en": "Exile", "gloss_es": "Expulsado de su hogar.", "gloss_en": "Banished from home.", "guide_es": "Añora lo perdido.", "guide_en": "Longs for what's lost."}, {"id": "paria", "es": "Paria", "en": "Pariah", "gloss_es": "Excluido por los suyos.", "gloss_en": "Outcast from their own.", "guide_es": "Sin bando que lo reclame.", "guide_en": "No side claims them."}, {"id": "elegido", "es": "Elegido", "en": "Chosen", "gloss_es": "Marcado por el destino.", "gloss_en": "Marked by destiny.", "guide_es": "No eligió ser elegido.", "guide_en": "Never chose to be chosen."}, {"id": "usurpador", "es": "Usurpador", "en": "Usurper", "gloss_es": "Toma el lugar que no le toca.", "gloss_en": "Takes a place not theirs.", "guide_es": "Corona robada, puño firme.", "guide_en": "Stolen crown, firm fist."}, {"id": "protegido", "es": "Protegido", "en": "Protégé", "gloss_es": "Alguien lo ampara.", "gloss_en": "Sheltered by another.", "guide_es": "Vive bajo un ala.", "guide_en": "Lives under a wing."}, {"id": "redentor", "es": "Redentor", "en": "Redeemer", "gloss_es": "Busca salvar a otros (o a sí).", "gloss_en": "Seeks to save others (or self).", "guide_es": "Paga culpas ajenas.", "guide_en": "Pays for others' guilt."}, {"id": "narrador", "es": "Narrador", "en": "Narrator", "gloss_es": "Cuenta la historia.", "gloss_en": "Tells the story.", "guide_es": "Elige qué se cuenta.", "guide_en": "Chooses what's told."}, {"id": "falso-protagonista", "es": "Falso protagonista", "en": "False protagonist", "gloss_es": "Parece el héroe, pero cae pronto.", "gloss_en": "Looks like the hero, falls early.", "guide_es": "Engaña al lector, no al destino.", "guide_en": "Fools the reader, not fate."}, {"id": "interes-romantico", "es": "Interés romántico", "en": "Love interest", "gloss_es": "Mueve el corazón del héroe.", "gloss_en": "Moves the hero's heart.", "guide_es": "Amar es su riesgo.", "guide_en": "Love is their risk."}, {"id": "alivio-comico", "es": "Alivio cómico", "en": "Comic relief", "gloss_es": "Rompe la tensión con humor.", "gloss_en": "Breaks tension with humor.", "guide_es": "Ríe donde duele.", "guide_en": "Laughs where it hurts."}, {"id": "figura-paterna", "es": "Figura paterna", "en": "Father figure", "gloss_es": "Protege como un padre.", "gloss_en": "Protects like a father.", "guide_es": "La muralla del héroe.", "guide_en": "The hero's wall."}, {"id": "figura-materna", "es": "Figura materna", "en": "Mother figure", "gloss_es": "Cuida como una madre.", "gloss_en": "Nurtures like a mother.", "guide_es": "El refugio del héroe.", "guide_en": "The hero's refuge."}, {"id": "hijo-prodigo", "es": "Hijo pródigo", "en": "Prodigal child", "gloss_es": "Volvió tras perderse.", "gloss_en": "Returned after losing their way.", "guide_es": "Perdonado, no olvidado.", "guide_en": "Forgiven, not forgotten."}, {"id": "mentor-oscuro", "es": "Mentor oscuro", "en": "Dark mentor", "gloss_es": "Enseña por el lado cruel.", "gloss_en": "Teaches through cruelty.", "guide_es": "Su lección deja cicatriz.", "guide_en": "Lessons leave scars."}, {"id": "sospechoso", "es": "Sospechoso", "en": "Suspect", "gloss_es": "Todos dudan de él.", "gloss_en": "Everyone doubts them.", "guide_es": "Parece culpable siempre.", "guide_en": "Always looks guilty."}, {"id": "victima", "es": "Víctima", "en": "Victim", "gloss_es": "Sufre el daño central.", "gloss_en": "Suffers the central harm.", "guide_es": "El motivo del héroe.", "guide_en": "The hero's motive."}, {"id": "acusado", "es": "Acusado", "en": "Accused", "gloss_es": "Carga con la culpa (¿justa?).", "gloss_en": "Bears blame (fairly?).", "guide_es": "Defiende su inocencia.", "guide_en": "Defends their innocence."}, {"id": "defensor", "es": "Defensor", "en": "Defender", "gloss_es": "Protege al acusado o débil.", "gloss_en": "Defends the accused or weak.", "guide_es": "Habla por el débil.", "guide_en": "Speaks for the weak."}, {"id": "mediador", "es": "Mediador", "en": "Mediator", "gloss_es": "Negocia entre bandos.", "gloss_en": "Negotiates between sides.", "guide_es": "Frena la guerra.", "guide_en": "Holds back war."}, {"id": "provocador", "es": "Provocador", "en": "Provocateur", "gloss_es": "Enciende el conflicto.", "gloss_en": "Sparks conflict.", "guide_es": "Busca la chispa.", "guide_en": "Seeks the spark."}, {"id": "saboteador", "es": "Saboteador", "en": "Saboteur", "gloss_es": "Destruye desde dentro.", "gloss_en": "Destroys from within.", "guide_es": "Su daño parece accidente.", "guide_en": "Damage looks like accident."}, {"id": "opresor", "es": "Opresor", "en": "Oppressor", "gloss_es": "Aplasta a los de abajo.", "gloss_en": "Crushes those below.", "guide_es": "Su paz exige rodillas.", "guide_en": "Their peace demands knees."}, {"id": "anfitrion", "es": "Anfitrión", "en": "Host", "gloss_es": "Recibe en su terreno.", "gloss_en": "Receives on their ground.", "guide_es": "Aquí mandan sus reglas.", "guide_en": "Their rules rule here."}, {"id": "bufon", "es": "Bufón", "en": "Jester", "gloss_es": "Dice verdades entre bromas.", "gloss_en": "Speaks truth through jokes.", "guide_es": "Payaso que acierta.", "guide_en": "A clown who's right."}, {"id": "sucesor", "es": "Sucesor", "en": "Successor", "gloss_es": "Hereda el puesto.", "gloss_en": "Inherits the seat.", "guide_es": "Espera su turno.", "guide_en": "Waits their turn."}, {"id": "gemelo-malvado", "es": "Gemelo malvado", "en": "Evil twin", "gloss_es": "Igual por fuera, oscuro dentro.", "gloss_en": "Same outside, dark inside.", "guide_es": "El héroe en negativo.", "guide_en": "The hero in negative."}], "professions": [{"id": "granjero", "es": "Granjero", "en": "Farmer"}, {"id": "pescador", "es": "Pescador", "en": "Fisher"}, {"id": "directivo", "es": "Directivo", "en": "Executive"}, {"id": "ingeniero-informatico", "es": "Ingeniero informático", "en": "Software engineer"}, {"id": "estudiante-universitario", "es": "Estudiante universitario", "en": "College student"}, {"id": "panadero", "es": "Panadero", "en": "Baker"}, {"id": "carpintero", "es": "Carpintero", "en": "Carpenter"}, {"id": "enfermera